{
    "name": "Balagh Alger — Signalement Citoyen",
    "short_name": "Balagh",
    "description": "Plateforme de signalement citoyen — Wilaya d'Alger",
    "id": "/home",
    "start_url": "/home",
    "display": "standalone",
    "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
    "background_color": "#0f172a",
    "theme_color": "#6366f1",
    "orientation": "portrait-primary",
    "categories": ["government", "utilities"],
    "lang": "fr",
    "dir": "auto",
    "scope": "/",
    "handle_links": "preferred",
    "launch_handler": {
        "client_mode": "auto"
    },
    "icons": [
        {
            "src": "/assets/img/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "/assets/img/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/assets/img/screenshot-mobile.png",
            "sizes": "1080x1920",
            "type": "image/png",
            "form_factor": "narrow"
        }
    ],
    "shortcuts": [
        {
            "name": "Nouveau signalement",
            "short_name": "Signaler",
            "url": "/reports/create",
            "icons": [{"src": "/assets/img/icon-192.png", "sizes": "192x192"}]
        },
        {
            "name": "Suivi public",
            "short_name": "Suivi",
            "url": "/suivi",
            "icons": [{"src": "/assets/img/icon-192.png", "sizes": "192x192"}]
        }
    ],
    "share_target": {
        "action": "/quick-report",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "description",
            "url": "url",
            "files": [
                {"name": "photos", "accept": ["image/jpeg", "image/png", "image/webp"]}
            ]
        }
    },
    "file_handlers": [
        {
            "action": "/quick-report",
            "accept": {
                "image/jpeg": [".jpg", ".jpeg"],
                "image/png": [".png"],
                "image/webp": [".webp"]
            }
        }
    ]
}
