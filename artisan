#!/usr/bin/env php
<?php
/**
 * Balagh Alger — CLI Artisan Tool
 *
 * Usage:
 *   php artisan queue:work          Start queue worker
 *   php artisan queue:status       Show queue sizes
 *   php artisan queue:failed       List failed jobs
 *   php artisan queue:retry <idx>  Retry a failed job
 *   php artisan queue:flush        Clear all failed jobs
 *   php artisan queue:dispatch <JobClass> [--data='{"key":"val"}']
 *   php artisan queue:release <sec> <JobClass> [--data='...']
 *   php artisan sla:run            Run SLA alerts now
 *   php artisan app:info           Show app info
 */

$root = __DIR__;

$envFile = $root . '/.env';
if (file_exists($envFile)) {
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') continue;
        if (strpos($line, '=') !== false) {
            [$key, $value] = explode('=', $line, 2);
            $key = trim($key);
            $value = trim($value);
            if (!getenv($key)) putenv("{$key}={$value}");
        }
    }
}

require_once $root . '/vendor/autoload.php';
require_once $root . '/app/Config/paths.php';
require_once APP_PATH . '/Helpers/Session.php';
require_once APP_PATH . '/Helpers/Database.php';
require_once APP_PATH . '/Helpers/Router.php';
require_once APP_PATH . '/Helpers/Csrf.php';
require_once APP_PATH . '/Helpers/Validator.php';
require_once APP_PATH . '/Helpers/Helper.php';
require_once APP_PATH . '/Helpers/AuditLog.php';
require_once APP_PATH . '/Helpers/Notification.php';
require_once APP_PATH . '/Helpers/I18n.php';
require_once APP_PATH . '/Helpers/Queue.php';

if (!function_exists('__')) {
    function __(string $key, array $replace = []): string {
        return \App\Helpers\I18n::t($key, $replace);
    }
}

spl_autoload_register(function ($class) {
    $path = APP_PATH . '/' . str_replace('\\', '/', str_replace('App\\', '', $class)) . '.php';
    if (file_exists($path)) {
        require_once $path;
    }
});

use App\Helpers\Queue;

$args = $argv;
$command = $args[1] ?? '';
$subArgs = array_slice($args, 2);

switch ($command) {

    case 'queue:work':
        $workerArgs = [];
        foreach ($subArgs as $arg) {
            $workerArgs[] = $arg;
        }
        array_unshift($workerArgs, $root . '/queue/worker.php');
        // Forward to worker
        $cmd = 'php ' . escapeshellarg($root . '/queue/worker.php');
        foreach ($subArgs as $sa) {
            $cmd .= ' ' . escapeshellarg($sa);
        }
        passthru($cmd);
        break;

    case 'queue:status':
        $sizes = Queue::sizes();
        echo "Queue sizes:\n";
        foreach ($sizes as $name => $count) {
            $bar = str_repeat('█', min($count, 40));
            printf("  %-10s %5d %s\n", $name, $count, $bar);
        }
        break;

    case 'queue:failed':
        $failed = Queue::getFailed();
        if (empty($failed)) {
            echo "No failed jobs.\n";
        } else {
            echo count($failed) . " failed job(s):\n";
            foreach ($failed as $i => $json) {
                $job = json_decode($json, true);
                printf("  [%d] %s | error: %s\n", $i, $job['job'], $job['error'] ?? '?');
            }
        }
        break;

    case 'queue:retry':
        $index = (int)($subArgs[0] ?? 0);
        $job = Queue::retryFailed($index);
        if ($job) {
            echo "Retried: {$job['job']}\n";
        } else {
            echo "No failed job at index {$index}\n";
        }
        break;

    case 'queue:flush':
        Queue::flushFailed();
        echo "Failed jobs cleared.\n";
        break;

    case 'queue:dispatch':
        $jobClass = $subArgs[0] ?? '';
        if (!$jobClass) {
            echo "Usage: php artisan queue:dispatch <JobClass> [--data='...']\n";
            exit(1);
        }
        $data = [];
        foreach ($subArgs as $arg) {
            if (str_starts_with($arg, '--data=')) {
                $data = json_decode(substr($arg, 7), true) ?? [];
            }
        }
        Queue::dispatch($jobClass, $data);
        echo "Dispatched: {$jobClass}\n";
        break;

    case 'queue:release':
        $delay = (int)($subArgs[0] ?? 30);
        $jobClass = $subArgs[1] ?? '';
        if (!$jobClass) {
            echo "Usage: php artisan queue:release <seconds> <JobClass> [--data='...']\n";
            exit(1);
        }
        $data = [];
        foreach ($subArgs as $arg) {
            if (str_starts_with($arg, '--data=')) {
                $data = json_decode(substr($arg, 7), true) ?? [];
            }
        }
        Queue::later($delay, $jobClass, $data);
        echo "Scheduled in {$delay}s: {$jobClass}\n";
        break;

    case 'sla:run':
        Queue::dispatch(\App\Jobs\SlaAlertJob::class);
        echo "SLA alert job dispatched to queue.\n";
        break;

    case 'app:info':
        $config = require APP_PATH . '/Config/app.php';
        echo "App: {$config['name']}\n";
        echo "Version: {$config['version']}\n";
        echo "Timezone: {$config['timezone']}\n";
        echo "PHP: " . PHP_VERSION . "\n";
        echo "Redis: " . (class_exists('Redis') ? 'YES' : 'NO') . "\n";
        try {
            $sizes = Queue::sizes();
            echo "Queue: connected\n";
            echo "  Delayed: {$sizes['delayed']}\n";
            echo "  Failed: {$sizes['failed']}\n";
        } catch (\Throwable $e) {
            echo "Queue: disconnected ({$e->getMessage()})\n";
        }
        break;

    default:
        echo <<<HELP
Balagh Alger Artisan CLI

Queue Commands:
  php artisan queue:work                Start queue worker
  php artisan queue:work --once         Process one job and exit
  php artisan queue:work --queue=high,def  Worker on specific queues
  php artisan queue:status              Show queue sizes
  php artisan queue:failed              List failed jobs
  php artisan queue:retry <index>       Retry a failed job
  php artisan queue:flush               Clear all failed jobs
  php artisan queue:dispatch <Job> [--data='{}']
  php artisan queue:release <sec> <Job> [--data='{}']

Other Commands:
  php artisan sla:run                   Run SLA alerts via queue
  php artisan app:info                  Show app info

HELP;
        break;
}
